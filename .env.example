# Django secret key (must be set in production, do not use weak or hardcoded keys)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key

# Enable or disable debug mode (False for production deployment)
DJANGO_DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost

# PostgreSQL Database name
POSTGRES_DB=cold_storage

# PostgreSQL Database username
POSTGRES_USER=postgres

# PostgreSQL Database user password
POSTGRES_PASSWORD=change-me-to-a-secure-db-password

# PostgreSQL host address (use 'db' service name when running inside docker-compose)
POSTGRES_HOST=db

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Comma-separated list of origins allowed to make cross-site HTTP requests
# For Capacitor mobile WebView support, append http://localhost (Android) and capacitor://localhost (iOS)
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,http://localhost,capacitor://localhost

# Comma-separated list of trusted origins for unsafe cross-site requests (CSRF protection)
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Redirect all non-HTTPS requests to HTTPS (set to False if TLS terminates at an external reverse proxy)
DJANGO_SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds (default: 31536000 = 1 year)
DJANGO_HSTS_SECONDS=31536000

# Base URL for API requests. Keep empty for standard web builds (resolves relatively).
# Set to the absolute API origin (e.g. https://cold.crystalcubes.in) for packaged mobile (Capacitor) builds.
VITE_API_BASE_URL=

