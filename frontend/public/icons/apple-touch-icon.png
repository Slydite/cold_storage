<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FB923C"/>
      <stop offset="50%" stop-color="#F97316"/>
      <stop offset="100%" stop-color="#EA580C"/>
    </linearGradient>
  </defs>

  <!-- Solid Non-Transparent Background for iOS (prevents black corner artifacts on iOS homescreen) -->
  <rect width="512" height="512" fill="url(#brandGrad)"/>

  <!-- Inner Squircle Outline for Visual Elevation -->
  <rect x="24" y="24" width="464" height="464" rx="96" fill="none" stroke="rgba(255, 255, 255, 0.25)" stroke-width="8"/>

  <!-- Geometric Cold Storage Snowflake Emblem -->
  <g fill="none" stroke="#FFFFFF" stroke-width="26" stroke-linecap="round" stroke-linejoin="round">
    <!-- Main 6 Radial Axes -->
    <line x1="256" y1="96" x2="256" y2="416"/>
    <line x1="117.4" y1="176" x2="394.6" y2="336"/>
    <line x1="117.4" y1="336" x2="394.6" y2="176"/>

    <!-- Central Hexagon Core -->
    <polygon points="256,216 290.6,236 290.6,276 256,296 221.4,276 221.4,236" stroke-width="20" fill="rgba(255, 255, 255, 0.15)"/>

    <!-- Vertical Arm Chevrons -->
    <path d="M216 136 L256 176 L296 136"/>
    <path d="M216 376 L256 336 L296 376"/>

    <!-- Top-Right / Bottom-Left Chevrons -->
    <path d="M336 156 L344 204 L392 196"/>
    <path d="M120 316 L168 308 L176 356"/>

    <!-- Top-Left / Bottom-Right Chevrons -->
    <path d="M120 196 L168 204 L176 156"/>
    <path d="M336 356 L344 308 L392 316"/>

    <!-- Warehouse Box/Pallet Accents on Main Vertical Axis -->
    <rect x="238" y="108" width="36" height="36" rx="6" fill="#FFFFFF" stroke="none"/>
    <rect x="238" y="368" width="36" height="36" rx="6" fill="#FFFFFF" stroke="none"/>
  </g>
</svg>
