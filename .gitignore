# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
backend/.venv/

# Django staticfiles
backend/staticfiles/

# SQLite databases
db/*.sqlite3
db/*.sqlite3-journal

# User-uploaded / generated media (invoice PDFs, etc.)
media/

# Secrets — never commit. .env.example is the tracked template.
.env
.env.*
!.env.example
temp_env
*.env

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# IDEs and OS
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
